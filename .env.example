# ==============================================
# NEBULA LOCAL - CONFIGURAÇÃO
# ==============================================

# Telegram API: https://my.telegram.org
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# Bot criado em: https://t.me/BotFather
# A edição local utiliza o primeiro token da lista.
BOT_TOKENS=1234567890:AA_TOKEN_DO_BOT

# Canal privado onde os documentos serão armazenados.
CHAT_ID=-1001234567890

# Banco de dados local.
SQLITE_PATH=data/nebula.db

# Servidor FTP.
HOST=0.0.0.0
PORT=2121
PASSIVE_PORTS=60000-60100

# Uploads.
MAX_WORKERS=4
CHUNK_SIZE_MB=64
MAX_RETRIES=5
MAX_STAGING_AGE=3600

# Logging: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
LOG_MAX_SIZE=5
LOG_BACKUP_COUNT=3
